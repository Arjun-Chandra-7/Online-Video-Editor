PORT=8080
VIRALIST_REQUIRE_AUTHORIZATION=true
# Use only approved absolute media directories, separated by ':' on Linux/macOS.
VIRALIST_MEDIA_ROOTS=/srv/viralist/inbox
# Inject this through a secret manager in real deployments.
VIRALIST_AUTHORIZATION_JSON={"actorId":"manager-service","allowedActions":["*"],"expiresAt":1893456000}
