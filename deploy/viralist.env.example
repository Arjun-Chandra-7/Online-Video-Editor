PORT=8080
VIRALIST_REQUIRE_AUTHORIZATION=true
VIRALIST_REQUIRE_SIGNED_TOKENS=true

# Cryptographic signing key used by Manager to sign auth tokens (min 32 characters)
VIRALIST_SIGNING_KEY=prod-secret-signing-key-change-this-in-production-vault

# Use only approved absolute media directories, separated by ':' on Linux/macOS.
VIRALIST_MEDIA_ROOTS=/srv/viralist/inbox

# Manager-issued signed token (format: v1.<payload_b64>.<signature_hex>)
VIRALIST_AUTHORIZATION_TOKEN=v1.eyJhY3RvcklkIjoibWFuYWdlci1zZXJ2aWNlIiwiYWxsb3dlZEFjdGlvbnMiOlsiKiJdfQ.sig

# Tunnel URL for remote review / collaboration
VIRALIST_TUNNEL_URL=https://editor.viralyst.internal
